# Embarque Amazônia — Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Ambiente de Execução (development / production)
ENVIRONMENT=development

# Servidor API FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Base de Dados (SQLite em desenvolvimento local)
DATABASE_URL=sqlite:///./database/embarque.db

# Configuração do Motor de Rotas
# Data de referência para recência dos trechos (YYYY-MM-DD). Se vazio, usa data do sistema.
DATA_REFERENCIA=2026-11-06

# CORS: Origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
